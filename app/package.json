  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
