{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion",
  "version": "0.1.0",
  "identifier": "dev.companion.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/engine": "../vendor/engine",
        "Resources/sample": "../sample",
        "Resources/ACKNOWLEDGEMENTS.txt": "../ACKNOWLEDGEMENTS.txt"
      },
      "minimumSystemVersion": "14.0"
    }
  }
}
